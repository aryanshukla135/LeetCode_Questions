#include <bits/stdc++.h>
using namespace std;

int main() {
    int t ;
    cin>>t ;
    while(t--){
       int n , k, x ;
       cin>>n>>k>>x ;
       
       vector<int> nums(n);
       nums[k-1] = x ;
     
      
       for(int i = 0 ; i<n ; i++){
          nums[i] = i+1;
       }
       vector<int> pre(n);
       pre[0] = nums[0];
       
       if(n>=2){
           pre[1] = nums[1];
       }
       
       for(int i = 2 ; i<n ; i++){
           pre[i] = pre[i-1] + nums[i];
       }
      if(k == 1 && x == 1){
          cout<<"YES"<<endl;
      }
       if(k == 2 && x == 2){
          cout<<"YES"<<endl;
      }
      if(nums[k-1] >= x){
          cout<<"NO"<<endl;
      }else{
          cout<<"YES"<<endl;
      }
        // for(int i : pre) cout<<i<<" ";
        // cout<<endl;
        
    }
    
   return 0; 
}
