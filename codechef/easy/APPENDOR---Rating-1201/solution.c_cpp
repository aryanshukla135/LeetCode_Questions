#include <bits/stdc++.h>
using namespace std;

int solve(int val , int y){
    for(int i = 0 ; i<= y ; i++){
            int a = (val |i);
            if(a == y){
                return i;
            }
        }
    return -1;    
}

int main() {
    int t ;
    cin>>t ;
    while(t--){
        int n,y ;
        cin>>n>>y;
        // vector<int> nums(n);
        int val = 0 ;
        for(int i =0 ; i<n ; i++){
            int x;
            cin>>x;
            val |= x;
        }
        
        int ans = solve(val,y);
        
        cout<<ans<<endl;
    }
    
   return 0; 
}